PORTAL_HTTP_ADDR=:8080
PORTAL_PUBLIC_URL=http://localhost:38480
PORTAL_FRONTEND_ORIGIN=http://localhost:38480
PORTAL_SESSION_COOKIE_NAME=portal_session
PORTAL_SESSION_TTL_HOURS=24
PORTAL_ADMIN_EMAIL=admin@portal.local
PORTAL_ADMIN_PASSWORD=change-me-now
PORTAL_DB_PATH=/app/data/portal.db
PORTAL_SHELL=/bin/sh
PORTAL_WORKSPACES_ROOT=/workspaces
PORTAL_WEB_ROOT=/app/public

PORTAL_CHROMIUM_INTERNAL_URL=https://chromium:3001/chromium
PORTAL_CHROMIUM_PUBLIC_URL=/chromium/

PORTAL_GUACAMOLE_INTERNAL_URL=http://guacamole:8080/guacamole
PORTAL_GUACAMOLE_ADMIN_USERNAME=portaladmin
PORTAL_GUACAMOLE_ADMIN_PASSWORD=change-me-guacadmin
PORTAL_GUACAMOLE_DATA_SOURCE=postgresql

GUACAMOLE_POSTGRES_DB=guacamole_db
GUACAMOLE_POSTGRES_USER=guacamole_user
GUACAMOLE_POSTGRES_PASSWORD=change-me-guacdb

# Legacy compatibility:
# PORTAL_CHROMIUM_URL can still be used, but prefer the explicit INTERNAL/PUBLIC
# variables above.

# Notes:
# - Portal is the only public entrypoint by default.
# - Guacamole, guacd, PostgreSQL, and Windows RDP stay on the internal Docker network.
# - Portal proxies Guacamole internally under /guacamole/ after Portal auth succeeds.
