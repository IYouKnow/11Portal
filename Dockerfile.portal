FROM node:22-alpine AS frontend-build
WORKDIR /frontend
COPY frontend/package.json ./
RUN npm install
COPY frontend/ ./
RUN npm run build

FROM golang:1.23-alpine AS backend-build
WORKDIR /backend
RUN apk add --no-cache build-base
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build -o /portal-api ./cmd/portal-api

FROM alpine:3.20
WORKDIR /app
RUN apk add --no-cache ca-certificates bash docker-cli openssh-client
COPY --from=backend-build /portal-api /usr/local/bin/portal-api
COPY --from=frontend-build /frontend/dist /app/public
EXPOSE 8080
CMD ["portal-api"]
